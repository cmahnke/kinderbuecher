{
  "name": "viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "serve": "python3 -m http.server 8080",
    "lint": "eslint src/ tests/ mnx2musicxml/",
    "lint:fix": "eslint src/ tests/ mnx2musicxml/ --fix",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"mnx2musicxml/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"mnx2musicxml/**/*.ts\" \"tests/**/*.ts\"",
    "stylelint": "stylelint src/**/*.css",
    "stylelint:fix": "stylelint src/**/*.css --fix",
    "check": "tsc --noEmit && eslint src/ tests/ mnx2musicxml/ && prettier --check \"src/**/*.{ts,css}\" \"mnx2musicxml/**/*.ts\" \"tests/**/*.ts\" && stylelint src/**/*.css",
    "test": "playwright test --grep-invert @mnx",
    "test:mnx": "playwright test --grep @mnx",
    "test:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@projektemacher/tify-plugin-core": "^0.2.0",
    "@projektemacher/tify-plugin-musicxml": "^0.2.0",
    "@xmldom/xmldom": "^0.9.12",
    "fraction.js": "^5.3.4",
    "opensheetmusicdisplay": "^2.2.1",
    "tify": "0.36.2",
    "xpath": "^0.0.35"
  }
}
